---
// src/components/GalleryPreview.astro
// Used on the homepage — shows the grid + filters.
// The full /galeria page has its own expanded layout.
import { GALLERY_ITEMS, GALLERY_FILTERS } from '../data/site';
---

<section id="galeria" aria-labelledby="gallery-heading">
  <div class="gallery-header">
    <div>
      <p class="section-label reveal">Portfolio</p>
      <h2 class="section-title reveal reveal-delay-1" id="gallery-heading">
        Un vistazo a<br />mi <em>trabajo</em>
      </h2>
    </div>
    <div class="gallery-filters" role="group" aria-label="Filtros de galería">
      {GALLERY_FILTERS.map((f) => (
        <button
          class={`filter-btn${f.id === 'all' ? ' active' : ''}`}
          data-filter={f.id}
          aria-pressed={f.id === 'all' ? 'true' : 'false'}
        >
          {f.label}
        </button>
      ))}
    </div>
  </div>

  <div class="gallery-grid" aria-label="Galería de fotografías" id="galleryGrid">
    {GALLERY_ITEMS.map((item, i) => (
      <div
        class={`gallery-item reveal reveal-delay-${i}${item.span ? ` span-${item.span}` : ''}`}
        data-category={item.category}
      >
        <div class="gallery-item-inner">
          {item.src
            ? <img src={item.src} alt={item.alt} loading="lazy" />
            : <span class="gallery-item-icon" aria-hidden="true">{item.icon}</span>
          }
          <div class="gallery-item-label"><span>{item.label}</span></div>
        </div>
      </div>
    ))}
  </div>

  <div class="gallery-cta reveal">
    <a href="/galeria" class="btn-primary">Ver galería completa</a>
  </div>
</section>

<style>
  section { background: var(--cream); padding: 100px 80px; }

  .gallery-header {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-bottom: 48px;
  }
  .gallery-filters {
    display: flex; gap: 0;
    border: 1px solid var(--sage-light);
  }
  .filter-btn {
    padding: 10px 22px;
    font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase;
    background: none; border: none;
    border-right: 1px solid var(--sage-light);
    color: var(--stone);
    cursor: none;
    transition: all 0.4s ease;
    font-family: var(--font-body);
  }
  .filter-btn:last-child { border-right: none; }
  .filter-btn.active, .filter-btn:hover {
    background: var(--sage-ink); color: white;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  .gallery-item {
    overflow: hidden;
    position: relative;
    background: var(--sage-light);
    cursor: none;
  }
  .gallery-item.hidden { display: none; }

  .gallery-item-inner {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    background: linear-gradient(160deg, var(--sage-pale) 0%, var(--sage-light) 60%, var(--sage-mist) 100%);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .gallery-item-inner img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .gallery-item:hover .gallery-item-inner img { transform: scale(1.06); }

  .gallery-item-icon { font-size: 2.5rem; opacity: 0.25; }

  .gallery-item-label {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 40px 16px 18px;
    background: linear-gradient(to top, rgba(74,107,69,0.75), transparent);
    transform: translateY(100%);
    transition: transform 0.4s ease;
  }
  .gallery-item:hover .gallery-item-label { transform: translateY(0); }
  .gallery-item-label span {
    font-family: var(--font-display);
    font-size: 1rem; font-style: italic; color: white;
  }

  .gallery-cta { text-align: center; margin-top: 48px; }

  @media (max-width: 900px) {
    section { padding: 70px 28px; }
    .gallery-header { flex-direction: column; align-items: flex-start; gap: 20px; }
    .gallery-filters { flex-wrap: wrap; }
    .filter-btn { cursor: auto; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); gap: 3px; }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items      = document.querySelectorAll<HTMLElement>('.gallery-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!;

      filterBtns.forEach((b) => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');

      items.forEach((item) => {
        const match = filter === 'all' || item.dataset.category === filter;
        item.classList.toggle('hidden', !match);
      });
    });
  });
</script>