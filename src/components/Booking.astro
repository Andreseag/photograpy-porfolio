---
// src/components/Booking.astro
const CAL_URL =
  'https://cal.com/laura-luisa-fernanda-rodriguez-rojas-qczl7a/sesion-fotografica?user=laura-luisa-fernanda-rodriguez-rojas-qczl7a&overlayCalendar=true';
---

<section id="agendar" aria-labelledby="booking-heading">
  <div class="booking-header">
    <p class="section-label reveal">Agenda tu sesión</p>
    <h2 class="section-title reveal reveal-delay-1" id="booking-heading">
      Reserva tu<br /><em>momento</em>
    </h2>
    <p class="booking-intro reveal reveal-delay-2">
      Elige el día y la hora que más te convenga. El calendario muestra
      mi disponibilidad en tiempo real — ¡sin llamadas ni correos de ida y vuelta!
    </p>
  </div>

  <!-- Cal.com inline embed -->
  <div class="cal-wrapper reveal reveal-delay-3">
    <div class="cal-loader" id="calLoader" aria-hidden="true">
      <span class="cal-loader-dot"></span>
      <span class="cal-loader-dot"></span>
      <span class="cal-loader-dot"></span>
    </div>
    <iframe
      id="calFrame"
      src={CAL_URL}
      title="Agendar sesión fotográfica con Laura Rodríguez"
      loading="lazy"
      allowfullscreen
      style="opacity:0; transition: opacity 0.5s ease;"
    ></iframe>
  </div>
</section>

<style>
  section {
    background: var(--warm-white);
    padding: 100px 80px;
  }

  .booking-header {
    max-width: 560px;
    margin: 0 auto 56px;
    text-align: center;
  }
  .booking-header .section-label {
    justify-content: center;
  }
  .booking-header .section-label::before { display: none; }

  .booking-intro {
    font-size: 0.85rem; line-height: 1.9;
    color: var(--ink-soft);
    margin-top: 20px;
  }

  /* ── Cal.com wrapper ── */
  .cal-wrapper {
    position: relative;
    width: 100%;
    min-height: 700px;
    border: 1px solid var(--sage-light);
    background: var(--sage-mist);
    overflow: hidden;
  }

  iframe#calFrame {
    display: block;
    width: 100%;
    min-height: 700px;
    border: none;
    background: transparent;
  }

  /* ── Loader dots shown while iframe loads ── */
  .cal-loader {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center; gap: 10px;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .cal-loader.hidden { opacity: 0; }

  .cal-loader-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--sage);
    animation: dotPulse 1.2s ease-in-out infinite;
  }
  .cal-loader-dot:nth-child(2) { animation-delay: 0.2s; }
  .cal-loader-dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes dotPulse {
    0%, 80%, 100% { transform: scale(0.7); opacity: 0.4; }
    40%           { transform: scale(1);   opacity: 1; }
  }

  @media (max-width: 900px) {
    section { padding: 70px 28px; }
    .cal-wrapper  { min-height: 600px; }
    iframe#calFrame { min-height: 600px; }
  }
</style>

<script>
  const frame  = document.getElementById('calFrame')  as HTMLIFrameElement;
  const loader = document.getElementById('calLoader') as HTMLElement;

  frame.addEventListener('load', () => {
    frame.style.opacity = '1';
    loader.classList.add('hidden');
  });
</script>