---
// src/components/Hero.astro
import { SITE } from '../data/site';
---

<section id="home" aria-label="Inicio">
  <div class="hero-left">
    <p class="hero-tag reveal">Fotografía con alma</p>
    <h1 class="hero-title reveal reveal-delay-1">
      Momentos que<br /><em>perduran</em><br />para siempre
    </h1>
    <p class="hero-desc reveal reveal-delay-2">{SITE.description}</p>
    <div class="hero-actions reveal reveal-delay-3">
      <a href="#agendar" class="btn-primary">Agendar sesión</a>
      <a href="/galeria" class="btn-ghost">
        Ver galería
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8H13M9 4l4 4-4 4" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
        </svg>
      </a>
    </div>
    <div class="hero-scroll" aria-hidden="true">Scroll</div>
  </div>

  <div class="hero-right" aria-hidden="true">
    <div class="hero-image-placeholder">
      <img src="/images/foto-retrato.webp" alt="Laura Rodríguez Fotografía" />
      <!-- <p class="hero-img-label">Tu foto<br />principal aquí</p> -->
    </div>
  </div>
</section>

<style>
  section {
    height: 100vh; min-height: 700px;
    display: grid; grid-template-columns: 1fr 1fr;
    position: relative; overflow: hidden;
  }
  .hero-left {
    display: flex; flex-direction: column;
    justify-content: center;
    padding: 140px 80px 80px;
    background: var(--sage-mist);
    position: relative; z-index: 2;
  }
  .hero-tag {
    font-size: 0.62rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--sage-deep);
    margin-bottom: 32px;
    display: flex; align-items: center; gap: 14px;
  }
  .hero-tag::before {
    content: '';
    display: block; width: 30px; height: 1px;
    background: var(--sage-deep);
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--ink);
    margin-bottom: 28px;
  }
  .hero-title em { font-style: italic; color: var(--sage-deep); }
  .hero-desc {
    font-size: 0.85rem; line-height: 1.9;
    color: var(--ink-soft);
    max-width: 380px; margin-bottom: 48px;
  }
  .hero-actions { display: flex; gap: 20px; align-items: center; }
  .hero-scroll {
    position: absolute; bottom: 40px; left: 80px;
    font-size: 0.6rem; letter-spacing: 0.3em;
    text-transform: uppercase; color: var(--stone);
    display: flex; align-items: center; gap: 12px;
  }
  .hero-scroll::after {
    content: '';
    display: block; width: 40px; height: 1px;
    background: var(--stone);
    animation: scrollLine 2s ease-in-out infinite;
  }
  @keyframes scrollLine {
    0%, 100% { width: 40px; opacity: 1; }
    50% { width: 20px; opacity: 0.4; }
  }
  .hero-right { position: relative; overflow: hidden; background: var(--sage-light); }
  .hero-image-placeholder {
    width: 100%; height: 100%;
    background: linear-gradient(145deg, var(--sage-light) 0%, var(--sage-pale) 50%, var(--sage-light) 100%);
    display: flex; align-items: center; justify-content: center;
    position: relative;
  }
  .hero-image-placeholder::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 30% 40%, rgba(181,201,176,0.4) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 70%, rgba(122,158,116,0.2) 0%, transparent 50%);
  }
  /* Real image inside hero-right */
  .hero-right img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }
  .hero-img-label {
    font-family: var(--font-display);
    font-size: 1rem; color: var(--sage-deep);
    opacity: 0.5; letter-spacing: 0.1em;
    font-style: italic; text-align: center; line-height: 2;
    position: relative; z-index: 1;
  }

  @media (max-width: 900px) {
    section { grid-template-columns: 1fr; height: auto; }
    .hero-left { padding: 120px 28px 60px; }
    .hero-right { height: 50vw; min-height: 260px; }
    .hero-scroll { left: 28px; bottom: 20px; }
    .hero-title { font-size: 2.8rem; }
  }
</style>

<script>
  // Immediately reveal hero elements (above the fold)
  document.querySelectorAll<HTMLElement>('#home .reveal').forEach((el, i) => {
    setTimeout(() => el.classList.add('visible'), 200 + i * 120);
  });
</script>
