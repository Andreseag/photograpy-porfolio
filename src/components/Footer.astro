---
// src/components/Footer.astro
import { SITE, SOCIAL_LINKS } from '../data/site';
---

<!-- Social Section -->
<section id="redes" aria-labelledby="social-heading">
  <p class="social-label reveal">Sígueme</p>
  <h2 class="social-title reveal reveal-delay-1" id="social-heading">
    Encuentra mi trabajo<br />en <em>redes sociales</em>
  </h2>
  <div class="social-links reveal reveal-delay-2">
    {SOCIAL_LINKS.map((s) => (
      <a
        href={s.url}
        target="_blank"
        rel="noopener noreferrer"
        class="social-link"
        aria-label={s.ariaLabel}
      >
        {s.name === 'Instagram' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        )}
        {s.name === 'Facebook' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        )}
        {s.name === 'Pinterest' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.477 2 12c0 4.236 2.636 7.855 6.356 9.312-.088-.791-.167-2.005.035-2.868.181-.78 1.172-4.97 1.172-4.97s-.299-.598-.299-1.482c0-1.388.806-2.428 1.808-2.428.852 0 1.265.64 1.265 1.408 0 .858-.546 2.14-.828 3.33-.236.995.499 1.806 1.476 1.806 1.772 0 3.137-1.868 3.137-4.566 0-2.39-1.717-4.061-4.166-4.061-2.836 0-4.5 2.127-4.5 4.326 0 .856.33 1.775.741 2.278a.3.3 0 0 1 .069.285c-.075.314-.243.995-.277 1.134-.045.181-.15.219-.345.132-1.249-.581-2.03-2.407-2.03-3.874 0-3.154 2.292-6.052 6.608-6.052 3.469 0 6.165 2.473 6.165 5.776 0 3.447-2.173 6.22-5.19 6.22-1.013 0-1.966-.527-2.292-1.148l-.623 2.378c-.226.869-.835 1.958-1.244 2.621.937.29 1.931.446 2.962.446 5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
          </svg>
        )}
        {s.name === 'TikTok' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
          </svg>
        )}
        {s.name === 'WhatsApp' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
        )}
        {s.name}
      </a>
    ))}
  </div>
</section>

<!-- Footer -->
<footer role="contentinfo">
  <div class="footer-logo">Laura Rodríguez Fotografía</div>
  <p class="footer-copy">© {new Date().getFullYear()} Laura Rodríguez · Todos los derechos reservados</p>
  <nav class="footer-links" aria-label="Links del pie de página">
    <a href="/">Inicio</a>
    <a href="/galeria">Galería</a>
    <a href="/#agendar">Agendar</a>
    <a href="/#redes">Contacto</a>
  </nav>
</footer>

<style>
  /* ── Social section ── */
  section {
    background: var(--sage-ink);
    padding: 80px;
    text-align: center;
  }
  .social-label {
    font-size: 0.6rem; letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--sage-light); opacity: 0.6;
    margin-bottom: 20px; display: block;
  }
  .social-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 300; color: var(--sage-light);
    margin-bottom: 48px;
  }
  .social-title em { font-style: italic; }

  .social-links {
    display: flex; justify-content: center;
    gap: 16px; flex-wrap: wrap;
  }
  .social-link {
    display: flex; align-items: center; gap: 12px;
    padding: 18px 32px;
    border: 1px solid rgba(212, 228, 207, 0.3);
    color: var(--sage-light); text-decoration: none;
    font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase;
    transition: all 0.4s ease; cursor: none;
  }
  .social-link:hover {
    background: rgba(212, 228, 207, 0.1);
    border-color: var(--sage-light);
  }
  .social-link svg { width: 18px; height: 18px; flex-shrink: 0; }

  /* ── Footer ── */
  footer {
    background: var(--ink);
    padding: 40px 80px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .footer-logo {
    font-family: var(--font-display);
    font-size: 1rem; font-style: italic; color: var(--stone);
  }
  .footer-copy {
    font-size: 0.62rem; letter-spacing: 0.1em;
    color: rgba(155, 148, 136, 0.5);
  }
  .footer-links { display: flex; gap: 28px; }
  .footer-links a {
    font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--stone); text-decoration: none;
    transition: color 0.4s ease; cursor: none;
  }
  .footer-links a:hover { color: var(--sage-light); }

  @media (max-width: 900px) {
    section { padding: 60px 28px; }
    .social-link { padding: 14px 20px; cursor: auto; }
    footer {
      padding: 32px 28px;
      flex-direction: column; gap: 16px; text-align: center;
    }
    .footer-links { gap: 16px; flex-wrap: wrap; justify-content: center; }
    .footer-links a { cursor: auto; }
  }
</style>
