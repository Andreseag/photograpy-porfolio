---
export const prerender = false;
import AdminPanel from '../../../layouts/AdminPanel.astro';

const supabase = (Astro.locals as typeof Astro.locals & { supabase: any }).supabase;
const q = (Astro.url.searchParams.get('q') ?? '').replace(/[,()%*]/g, ' ').trim();
const ok = Astro.url.searchParams.get('ok');

let query = supabase.from('clients').select('id, name, phone, email').order('name');
if (q) query = query.or(`name.ilike.%${q}%,email.ilike.%${q}%,phone.ilike.%${q}%`);

const { data: clients, error } = await query;

const messages: Record<string, string> = {
  creado: 'Cliente creado',
  actualizado: 'Cambios guardados',
};
---
<AdminPanel title="Clientes" active="clientes">
  <div class="page-head">
    <div>
      <p class="eyebrow">Gestión</p>
      <h1>Clientes</h1>
    </div>
    <a class="btn" href="/admin/clientes/nuevo">Nuevo cliente</a>
  </div>

  {ok && messages[ok] && <p class="alert ok">{messages[ok]}</p>}
  {error && <p class="alert err">No se pudieron cargar los clientes.</p>}

  <form class="search" method="GET">
    <input name="q" value={q} placeholder="Buscar por nombre, correo o teléfono" />
    <button class="btn ghost" type="submit">Buscar</button>
  </form>

  <div class="table-wrap">
    {clients && clients.length > 0 ? (
      <table>
        <thead>
          <tr><th>Nombre</th><th>Teléfono</th><th>Correo</th></tr>
        </thead>
        <tbody>
          {clients.map((c: { id: string; name: string; phone: string | null; email: string | null }) => (
            <tr>
              <td><a href={`/admin/clientes/${c.id}`}>{c.name}</a></td>
              <td>{c.phone ?? '—'}</td>
              <td>{c.email ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p class="empty">
        {q ? 'Sin resultados para esa búsqueda.' : 'Aún no hay clientes. Crea el primero.'}
      </p>
    )}
  </div>
</AdminPanel>