---
export const prerender = false;
import type { SupabaseClient } from '@supabase/supabase-js';
import AdminPanel from '../../../layouts/AdminPanel.astro';
import SessionForm from '../../../components/SessionForm.astro';  
import { parseSessionForm, emptySession } from '../../../lib/sessions';

const supabase = (Astro.locals as unknown as { supabase: SupabaseClient }).supabase;
const { data: clients } = await supabase.from('clients').select('id, name').order('name');

let error = '';
let values = emptySession(Astro.url.searchParams.get('cliente') ?? '');

// Fecha precargada desde el calendario (?fecha=YYYY-MM-DD)
const fecha = Astro.url.searchParams.get('fecha') ?? '';
if (/^\d{4}-\d{2}-\d{2}$/.test(fecha)) values.starts_at = `${fecha}T09:00`;

if (Astro.request.method === 'POST') {
  const parsed = parseSessionForm(await Astro.request.formData());
  values = parsed.values;

  if (parsed.error || !parsed.payload) {
    error = parsed.error ?? 'Datos no válidos';
  } else {
    const { error: e } = await supabase.from('sessions').insert(parsed.payload);
    if (e) error = 'No se pudo guardar. Intenta de nuevo.';
    else return Astro.redirect('/admin/sesiones?vista=todas&ok=creada');
  }
}

const noClients = !clients || clients.length === 0;
---
<AdminPanel title="Nueva sesión" active="sesiones">
  <div class="page-head">
    <div>
      <p class="eyebrow">Sesiones</p>
      <h1>Nueva sesión</h1>
    </div>
  </div>

  {noClients ? (
    <p class="alert err">
      Primero necesitas un cliente. <a href="/admin/clientes/nuevo">Crear cliente</a>
    </p>
  ) : (
    <SessionForm values={values} clients={clients!} error={error} submitLabel="Crear sesión" />
  )}
</AdminPanel>